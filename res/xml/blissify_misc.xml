<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/blissify_misc_title">

    <PreferenceCategory
        android:title="@string/general_category">

        <Preference
            android:key="default_usb_configuration"
            android:title="@string/usb_default_config_title"
            android:summary="@string/usb_default_config_summary"
            android:fragment="com.android.settings.connecteddevice.usb.UsbDefaultFragment" />

    <com.bliss.support.preferences.SecureSettingSwitchPreference
        android:key="show_clipboard_overlay"
        android:title="@string/show_clipboard_overlay_title"
        android:summary="@string/show_clipboard_overlay_summary"
        android:defaultValue="true"/>

    <!-- Smart Pixels -->
    <Preference
        android:key="smart_pixels"
        android:title="@string/smart_pixels_title" 
        android:summary="@string/smart_pixels_summary" 
        android:fragment="org.blissroms.blissify.fragments.misc.SmartPixels" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="developer_options_category"
        android:title="@string/developer_options_category">

    <com.bliss.support.preferences.SecureSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false"/>

    <Preference
    	android:key="hide_developer_status_settings"
        android:title="@string/hide_developer_status_title"
        android:summary="@string/hide_developer_status_summary"
        android:fragment="com.android.settings.security.HideDeveloperStatusSettings"
        settings:controller="com.android.settings.security.HideDeveloperStatusPreferenceController" />  

    </PreferenceCategory>

    <PreferenceCategory
        android:key="miscellaneous_spoofing_category"
        android:title="@string/miscellaneous_spoofing_category">

        <!-- Component spoofing -->
        <Preference
            android:key="spoofing"
            android:title="@string/spoofing_title"
            android:summary="@string/spoofing_summary"
            android:fragment="org.blissroms.blissify.fragments.misc.Spoofing" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="blissos_options_category"
        android:title="@string/blissos_options_category">

        <com.bliss.support.preferences.SystemSettingSwitchPreference
                android:key="force_mouse_as_touch"
                android:title="@string/force_click_as_touch"
                android:summary="@string/force_click_as_touch_summary"
                settings:iconSpaceReserved="false"
                android:defaultValue="false" />

        <com.bliss.support.preferences.SystemSettingListPreference
            android:key="prevent_pointer_acceleration"
            android:title="@string/prevent_pointer_acceleration_title"
            android:summary="%s"
            android:dialogTitle="@string/prevent_pointer_acceleration_title"
            android:entries="@array/prevent_pointer_acceleration_entries"
            android:entryValues="@array/prevent_pointer_acceleration_values"
            android:defaultValue="0" />

        <com.bliss.support.preferences.SystemSettingListPreference
            android:key="transient_task_mode"
            android:title="@string/transient_task_mode_title"
            android:summary="@string/transient_task_mode_summary"
            android:dialogTitle="@string/transient_task_mode_dialog_title"
            android:entries="@array/transient_task_mode_entries"
            android:entryValues="@array/transient_task_mode_values"
            android:defaultValue="0" />

        <com.bliss.support.preferences.SystemSettingSwitchPreference
            android:key="alert_window_bypass_low_ram"
            android:title="@string/bypass_low_ram"
            android:summary="@string/bypass_low_ram_summary"
            settings:iconSpaceReserved="false"
            android:defaultValue="false" />
    </PreferenceCategory>

</PreferenceScreen>
